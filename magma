#!/usr/bin/env python

import re as regex
from sys import stderr

TAB_SIZE = 4
ENABLE_MACRO = True

functions = {}

source = 'test.mcfd'

def warn(message: str, pos: int | None = None):
    print('\033[93;1m[WARNING]:\033[0m', message, f'''({source}:{pos})''' if pos else f'''({source})''', file=stderr)
def error(message: str, pos: int | None = None):
    print('\033[91;1m[ERROR]:\033[0m', message, f'''({source}:{pos})''' if pos else f'''({source})''', file=stderr)
    exit(1)
def debug(message: str, pos: int | None = None):
    print('\033[96;1m[DEBUG]:\033[0m', message, f'''({source}:{pos})''' if pos else f'''({source})''', file=stderr)

